# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this app is hosted.
APP_URL=http://localhost:3000

# Email Delivery Service Configuration (Required for real Forgot Password verification codes)
# Configure your SMTP credentials (e.g. Gmail, SendGrid, Mailgun, AWS SES, or Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false
EMAIL_FROM="Projevo AI Security <no-reply@projevo.ai>"

# Optional Persistent Storage Configuration
# Override database file location or configure external storage for production / Vercel deployment
# DB_PATH=/path/to/server_db.json
# DATABASE_URL=postgresql://user:password@host:port/database
