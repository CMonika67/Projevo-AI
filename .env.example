# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this app is hosted.
APP_URL=http://localhost:3000

# Supabase Auth & PostgreSQL Configuration
# Set either NEXT_PUBLIC_SUPABASE_* or SUPABASE_* variable names
NEXT_PUBLIC_SUPABASE_URL=https://ubzlknzzxszlmakzlpki.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key (backend server only)

# Email Delivery Service Configuration (Required for real Forgot Password verification codes)
# Configure your SMTP credentials (e.g. Gmail, SendGrid, Mailgun, AWS SES, or Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false
EMAIL_FROM="Projevo AI Security <no-reply@projevo.ai>"

# Optional Persistent Storage Configuration
# Override database file location or configure external storage for production / Vercel deployment
# DB_PATH=/path/to/server_db.json
# DATABASE_URL=postgresql://user:password@host:port/database
